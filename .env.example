# Required Discord & AI Credentials
DISCORD_TOKEN=your_discord_bot_token_here
GEMINI_API_KEY=your_gemini_api_key_here

# Bot Owner Access (Required to unlock the /data Admin Panel)
BOT_OWNER_ID=

# Database Encryption Key (Custom key for AES-256 field encryption at rest)
DATABASE_ENCRYPTION_KEY=

# GitHub Machine Token (Increases rate limit to 5k req/hr & clones public repositories)
GITHUB_TOKEN=

# Optional: Local SearXNG Search Endpoint
SEARXNG_URL=http://localhost:8080

# Optional: GitHub App Integration (for /agent PR automation & verified commits)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=github_app.pem
GITHUB_WEBHOOK_SECRET=
SMEE_URL=

# Optional: Multi-Provider Generation (/generate)
GROQ_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_URL=http://localhost:11434
