# ==============================================================================
# PriestyAI Discord Bot - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE DISCORD CREDENTIALS (REQUIRED)
# ------------------------------------------------------------------------------
# Your Discord Bot Token (From Discord Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=your_discord_bot_token_here

# Your Discord User ID (Right-click your profile in Discord with Dev Mode on -> Copy User ID)
# Used for owner-only diagnostic commands like /start
OWNER_ID=123456789012345678

# Dedicated Private Server (Guild) ID used as the Bot's persistent brain & database
# The bot will create forum channels here to store vector memories, configs, and contexts
BRAIN_SERVER_ID=123456789012345678


# ------------------------------------------------------------------------------
# 2. GOOGLE GEMINI AI CONFIGURATION (REQUIRED)
# ------------------------------------------------------------------------------
# Primary Gemini API Key (From https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=AIzaSyYourPrimaryGeminiApiKeyHere

# Dedicated Gemini API keys for Server News generation (Optional - Prevents rate limits with main chat)
GEMINI_NEWS_KEY_MORNING=AIzaSyYourMorningNewsGeminiKeyHere
GEMINI_NEWS_KEY_EVENING=AIzaSyYourEveningNewsGeminiKeyHere

# Gemini Model Tiers (Defaults recommended)
GEMINI_MODEL_PREMIUM=gemini-2.5-flash
GEMINI_MODEL_TEXT=gemma-4-31b-it
GEMINI_NEWS_MODEL=gemini-2.5-flash

# Gemini Live Voice (Experimental / Slated for migration)
LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_VOICE_NAME=Puck


# ------------------------------------------------------------------------------
# 3. SERVER NEWS & VIDEO GENERATION ENGINE (OPTIONAL / FEATURE-SPECIFIC)
# ------------------------------------------------------------------------------
# Comma-separated list of Guild IDs permitted to activate Server News in /config
NEWS_ENABLED=123456789012345678

# Pexels API Key for HD stock video loops & B-roll photos (https://www.pexels.com/api/)
PEXELS_KEY=your_pexels_api_key_here

# Streamable Credentials for automatic news video hosting upload (https://streamable.com/)
STREAMABLE_EMAIL=your_email@example.com
STREAMABLE_PASSWORD=your_streamable_password_here


# ------------------------------------------------------------------------------
# 4. IMAGE GENERATION BACKENDS (OPTIONAL)
# ------------------------------------------------------------------------------
# Pixazo Gateway API Key for Flux-1 & SDXL models (https://gateway.pixazo.ai/)
# Note: Fallbacks to Pollinations AI (free) and AI Horde if omitted
PIXAZO_API_KEY=your_pixazo_api_key_here
IMG_API_KEY=your_pixazo_api_key_here

# AI Horde API Key (https://aihorde.net/ - use '0000000000' for anonymous free tier)
AI_HORDE_KEY=0000000000


# ------------------------------------------------------------------------------
# 5. KEEP-ALIVE WEB SERVER (HOSTING / CONTAINER SETTINGS)
# ------------------------------------------------------------------------------
# Port for lightweight health check ping server (used by Render/Railway/Fly.io)
PORT=8080