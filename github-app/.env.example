# ==============================================================================
# PriestyAI GitHub App & Automation Bot - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MACHINE USER ACCOUNT CREDENTIALS (REQUIRED)
# ------------------------------------------------------------------------------
# Personal Access Token (PAT) for the machine user account (@PriestyAI)
# Scopes needed: repo, read:org, user (for accepting invitations, reviews, PR commits)
GITHUB_TOKEN=ghp_yourPersonalAccessTokenHere

# The GitHub username of the machine bot account
BOT_USERNAME=PriestyAI


# ------------------------------------------------------------------------------
# 2. GITHUB APP AUTHENTICATION (REQUIRED)
# ------------------------------------------------------------------------------
# Numeric App ID from GitHub App Settings -> General -> About
GITHUB_APP_ID=123456

# Relative path to your downloaded GitHub App Private Key (.pem file)
GITHUB_APP_PRIVATE_KEY_PATH=github_app.pem

# Webhook Secret configured in your GitHub App settings (for HMAC-SHA256 signature verification)
# Leave empty for local testing without signature validation
GITHUB_WEBHOOK_SECRET=your_webhook_secret_string_here


# ------------------------------------------------------------------------------
# 3. WEBHOOK EVENT INGESTION / LOCAL DEV PROXY (REQUIRED FOR LOCAL DEV)
# ------------------------------------------------------------------------------
# Smee.io Channel URL for forwarding webhooks to localhost without port forwarding
# Create a new channel at https://smee.io/
SMEE_URL=https://smee.io/your_unique_smee_channel_id


# ------------------------------------------------------------------------------
# 4. AI PROVIDER CONFIGURATION (STANDARD VS. ENTERPRISE)
# ------------------------------------------------------------------------------
# Provider mode: "gemini" (Google AI Studio) or "vertex" (Enterprise Google Cloud Vertex AI)
LLM_PROVIDER=gemini

# --- Option A: Google AI Studio Keys (Used if LLM_PROVIDER=gemini) ---
GEMINI_API_KEY=AIzaSyYourPrimaryGeminiKeyHere
GEMINI_API_KEY_2=AIzaSyBackupKey2Here
GEMINI_API_KEY_3=AIzaSyBackupKey3Here
GEMINI_API_KEY_4=AIzaSyBackupKey4Here

# --- Option B: Google Cloud Vertex AI (Used if LLM_PROVIDER=vertex) ---
# Authenticates automatically via Application Default Credentials (ADC) / Workload Identity
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
VERTEX_MODEL=gemini-3.5-pro


# ------------------------------------------------------------------------------
# 5. DOCKER SANDBOX SECURITY SETTINGS
# ------------------------------------------------------------------------------
# Network isolation mode: "none" (Enterprise Zero-Egress) or "bridge" (Allow internet)
DOCKER_NETWORK_MODE=none


# ------------------------------------------------------------------------------
# 5. FASTAPI SERVER SETTINGS
# ------------------------------------------------------------------------------
# Host & Port for the FastAPI webhook server
HOST=0.0.0.0
PORT=8000